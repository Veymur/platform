{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Polar diagnostic processing v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "capture_id": {
      "type": "string"
    },
    "process_run_id": {
      "type": "string"
    },
    "processing_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "input_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "processed_utc_ms": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "processed_elapsed_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "command_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "applied",
        "ignored",
        "accepted",
        "rejected",
        "committed",
        "failed"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "root_id": {
              "const": 0
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "class_name": {
                    "type": "string"
                  },
                  "message": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "localized_message": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "stack_trace": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "declaring_class": {
                          "type": "string"
                        },
                        "method_name": {
                          "type": "string"
                        },
                        "file_name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "line_number": {
                          "type": "integer",
                          "minimum": -2147483648,
                          "maximum": 2147483647
                        },
                        "native_method": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "declaring_class",
                        "method_name",
                        "file_name",
                        "line_number",
                        "native_method"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "cause_id": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "suppressed_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "required": [
                  "id",
                  "class_name",
                  "message",
                  "localized_message",
                  "stack_trace",
                  "cause_id",
                  "suppressed_ids"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "root_id",
            "nodes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "capture_id",
    "process_run_id",
    "processing_sequence",
    "input_sequence",
    "processed_utc_ms",
    "processed_elapsed_ns",
    "session_id",
    "command_id",
    "outcome",
    "error"
  ],
  "additionalProperties": false
}

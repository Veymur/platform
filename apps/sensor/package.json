{
  "name": "veymur-sensor",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": "10.9.7"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "android": "expo run:android",
    "build:android": "android/gradlew -p android :app:assembleDebug",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:android": "android/gradlew -p android :veymur-recorder:lintDebug",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "expo": "57.0.28",
    "expo-build-properties": "57.0.22",
    "expo-dev-client": "57.0.20",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
